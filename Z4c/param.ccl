# Parameter definitions for thorn Z4c

BOOLEAN calc_ADM_vars "Calculate ADM variables" STEERABLE=recover
{
} yes

BOOLEAN calc_ADMRHS_vars "Calculate RHS of ADM variables" STEERABLE=recover
{
} yes

BOOLEAN calc_constraints "Calculate constraints" STEERABLE=recover
{
} yes


BOOLEAN set_Theta_zero "set Theta to zero, which converts Z4c to BSSN"
{
} no

CCTK_REAL kappa1 "kappa1" STEERABLE=always
{
  *:* :: ""
} 0.02

CCTK_REAL kappa2 "kappa2" STEERABLE=always
{
  *:* :: ""
} 0.0

BOOLEAN covariant_z4_damping "Rescale kappa1 by the inverse lapse so that lapse*kappa1 remains constant" STEERABLE=always
{
} no

CCTK_REAL f_mu_L "mu_L = f_mu_L / alpha" STEERABLE=always
{
  *:* :: ""
} 2.0

CCTK_REAL f_mu_S "mu_S = f_mu_S / alpha^2" STEERABLE=always
{
  *:* :: ""
} 1.0

CCTK_REAL eta "eta" STEERABLE=always
{
  *:* :: ""
} 2.0

CCTK_REAL lapse_advection_coefficient "Coefficient multiplying shift advection of the lapse" STEERABLE=always
{
  *:* :: "Any finite coefficient"
} 1.0

CCTK_REAL shift_advection_coefficient "Coefficient multiplying shift self-advection" STEERABLE=always
{
  *:* :: "Any finite coefficient"
} 1.0

CCTK_REAL veta_width "" STEERABLE=always
{
  (0:* :: ""
} 50.0

CCTK_REAL veta_central "" STEERABLE=always
{
  (0:* :: ""
} 2.0

CCTK_REAL veta_outer "" STEERABLE=always
{
  (0:* :: ""
} 0.25

KEYWORD eta_profile "Spatial profile for the Gamma-driver shift damping eta"
{
  "radial" :: "Use the existing radial veta_central/veta_outer profile"
  "puncture_tracker" :: "Use PunctureTracker locations and masses to build a position-dependent profile"
  "radial_puncture_tracker" :: "Use the existing radial profile as a baseline for a PunctureTracker-centered position-dependent profile"
} "radial"

CCTK_REAL eta_reference_mass "Reference mass m0 in the position-dependent eta profile; non-positive uses the smallest active puncture mass" STEERABLE=always
{
  *:* :: "non-positive selects the smallest active puncture mass"
} -1.0

CCTK_REAL eta_profile_coefficient "Overall coefficient C for the position-dependent eta profile" STEERABLE=always
{
  *:* :: ""
} 1.0

CCTK_INT eta_profile_power "Power n in the generalized denominator 1 + w_i (r_i/m0)^(2n)" STEERABLE=always
{
  1:8 :: "positive integer"
} 1

CCTK_REAL eta_profile_min "Lower clamp for the position-dependent eta profile" STEERABLE=always
{
  0:* :: "eta is a damping rate"
} 0.0

CCTK_REAL eta_profile_max "Upper clamp for the position-dependent eta profile" STEERABLE=always
{
  (0:* :: "eta is a damping rate"
} 1.0e100

CCTK_REAL chi_floor "Floor for chi" STEERABLE=always
{
  (0:* :: ""
} 1.0e-10

CCTK_REAL alphaG_floor "Floor for alphaG" STEERABLE=always
{
  (0:* :: ""
} 1.0e-10

CCTK_REAL epsdiss "Dissipation coefficient <arXiv:gr-qc/0610128>" STEERABLE=always
{
  0.0:* :: ""
} 0.32

KEYWORD boundary_conditions "boundary conditions"{
  "NewRadX" :: "radiative boundary conditions using NewRadX"
  "CarpetX" :: "use CarpetX default boundary conditions"
} "CarpetX"

CCTK_INT n_chi "n power of outgoing boundary r^n fall off rate for chi"
{
  0:2           :: "1 is reasonable"
} 1

CCTK_INT n_gammat "n power of outgoing boundary r^n fall off rate for gammat_ij"
{
  0:2           :: "1 is reasonable"
} 1

CCTK_INT n_Kh "n power of outgoing boundary r^n fall off rate for Kh"
{
  0:2           :: "Maybe 1?"
} 1

CCTK_INT n_At "n power of outgoing boundary r^n fall off rate for At_ij"
{
  0:2           :: "Maybe 1?"
} 1

CCTK_INT n_Gamt "n power of outgoing boundary r^n fall off rate for Gamt^i"
{
  0:2           :: "Maybe 1?"
} 1

CCTK_INT n_Theta "n power of outgoing boundary r^n fall off rate for Theta"
{
  0:2           :: "Maybe 1?"
} 1

CCTK_INT n_alphaG "n power of outgoing boundary r^n fall off rate for alpha"
{
  0:2           :: "1 is my guess"
} 1

CCTK_INT n_betaG "n power of outgoing boundary r^n fall off rate for beta"
{
  0:2           :: "1 is my guess"
} 1


RESTRICTED:

CCTK_INT timelevels "Number of time levels for the state" STEERABLE=recover
{
  0:4 :: ""
} 1
