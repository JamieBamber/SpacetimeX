# Psi4 must be computed only when every AMR level is at the same physical
# time.  Scheduling it after the subcycled evolution step would apply the
# cadence test during individual level advances, leaving fine-level Psi4
# values stale at output times.
SCHEDULE GROUP WeylScal4_psi4_calc_4th_group AT analysis BEFORE Multipole_Calc
{
} "WeylScal4_psi4_calc_4th_group"

SCHEDULE GROUP WeylScal4_psi4_sync_group AT analysis
  AFTER WeylScal4_psi4_calc_4th_group BEFORE Multipole_Calc
{
} "Synchronize Psi4 after calculating it"

