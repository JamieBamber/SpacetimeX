# Interface definition for thorn PunctureTracker

IMPLEMENTS: PunctureTracker

INHERITS: ADMBaseX CoordinatesX BoxInBox

USES INCLUDE HEADER: loop_device.hxx

PUBLIC:

CCTK_REAL pt_loc[100] TYPE=scalar
{
	pt_loc_t pt_loc_x pt_loc_y pt_loc_z
} "Location of punctures"

CCTK_REAL pt_vel[100] TYPE=scalar
{
  pt_vel_t pt_vel_x pt_vel_y pt_vel_z
} "Velocity of punctures"

CCTK_REAL pt_properties[100] TYPE=scalar
{
  pt_mass pt_eta_weight
} "Properties of tracked punctures"

CCTK_INT pt_count[1] TYPE=scalar
{
  pt_num_tracked
} "Number of tracked punctures"

CCTK_INT pt_group_count[1] TYPE=scalar
{
  pt_num_groups
} "Number of effective grouped sources"

CCTK_INT pt_membership[100] TYPE=scalar
{
  pt_group_membership
} "Effective grouped source index for each puncture"

CCTK_REAL pt_group_loc[100] TYPE=scalar
{
  pt_group_t pt_group_x pt_group_y pt_group_z
} "Location of effective grouped sources"

CCTK_REAL pt_group_properties[100] TYPE=scalar
{
  pt_group_mass pt_group_eta_weight
} "Properties of effective grouped sources"

CCTK_INT FUNCTION DriverInterpolate(
  CCTK_POINTER_TO_CONST IN cctkGH,
  CCTK_INT IN N_dims,
  CCTK_INT IN local_interp_handle,
  CCTK_INT IN param_table_handle,
  CCTK_INT IN coord_system_handle,
  CCTK_INT IN N_interp_points,
  CCTK_INT IN interp_coords_type,
  CCTK_POINTER_TO_CONST ARRAY IN interp_coords,
  CCTK_INT IN N_input_arrays,
  CCTK_INT ARRAY IN input_array_indices,
  CCTK_INT IN N_output_arrays,
  CCTK_INT ARRAY IN output_array_types,
  CCTK_POINTER ARRAY IN output_arrays)
REQUIRES FUNCTION DriverInterpolate
